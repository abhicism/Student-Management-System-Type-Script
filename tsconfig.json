{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "verbatimModuleSyntax": false,
        "skipLibCheck": true
    },

    "include": [
        "src"
    ],

    "exclude": [
        "node_modules",
        "dist"
    ]
}